# 复制为服务器 /home/oy/app/oyblogdeploy/blogagent/deploy/.env 并填真实值（该文件不入库）
# 本文件经 deploy.sh --sync-config 同步（MD5 有变化才上传）
# ===== DeepSeek API =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# ===== Elasticsearch：与中间件同网络（oyblog_oyblog-net），容器名直连 =====
# 容器名以服务器实际 docker ps 为准（与 oy-blog 后端 .env 的 ES_HOST 一致）
ES_URL=http://elasticsearch:9200
ES_USERNAME=elastic
ES_PASSWORD=
# ===== 时区 =====
TZ=Asia/Shanghai
